  "口述后处理": [
    {
      "场景": "口误修正",
      "模式": "(不对不对|说错了|不是|改一下|等一下)[，。]*",
      "处理": "取后续内容覆盖前值",
      "示例": "零点八...不对不对，零点九→取0.9"
    },
    {
      "场景": "事后补充",
      "模式": "(刚才那个|前面那个|之前的).*(改成|改为|写)",

  "L2_中文数字转换": [
    {
      "模式": "点[零一二三四五六七八九十]",
      "替换": "点\\g<0>",
      "说明": "点X → .X（点八→.8）",
      "示例": [
        [
          "点八",
          ".8"
        ],
        [
          "点五",
          ".5"
        ],
        [
          "点三",
          ".3"
        ]
      ]
    },
    {
      "模式": "[零一二三四五六七八九十]点[零一二三四五六七八九十]",
      "替换": "\\g<0>",
      "说明": "X点Y → X.Y（一点二→1.2）"
    },
    {
      "模式": "零点[零一二三四五六七八九十]",
      "替换": "0.\\g<0>",
      "说明": "零点X → 0.X（零点五→0.5）"
    },
    {
      "模式": "[两二]个",
      "替换": "2个",
      "说明": "川渝'两个'读法统一"
    },
    {
      "模式": "一两([分厘毫])",
      "替换": "1-2\\1",
      "说明": "一两公分=1-2cm"
    },

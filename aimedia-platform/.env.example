# ── 数据库 (开发用 SQLite, 生产用 PostgreSQL) ──
# 开发:
DATABASE_URL=sqlite+aiosqlite:///./aimedia.db
# 生产:
# DATABASE_URL=postgresql+asyncpg://aimedia:aimedia123@localhost:5432/aimedia

# ── Redis (生产需要) ──
REDIS_URL=redis://localhost:6379/0

# ── LLM ──
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# ── JWT ──
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── 文件存储 ──
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=500

# ── 钉钉(可选) ──
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# ── 环境 ──
ENV=development
LOG_LEVEL=DEBUG

# ============================================
# AI融媒体平台 - 生产环境配置
# ============================================

# 数据库 (生产用 PostgreSQL)
DATABASE_URL=postgresql+asyncpg://aimedia:CHANGE_THIS_PASSWORD@postgres:5432/aimedia

# Redis
REDIS_URL=redis://redis:6379/0

# JWT (生产必须更换强密钥)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# LLM API
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-CHANGE_ME
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# 文件存储
STORAGE_DIR=/data/storage
MAX_UPLOAD_SIZE_MB=500

# 钉钉 (可选)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# 环境
ENV=production
LOG_LEVEL=INFO

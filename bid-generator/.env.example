# ============================================
# 智能标书生成工具 — 环境配置
# 复制此文件为 .env 并填写实际值
# ============================================

# ── 服务器配置 ──────────────────────────────────
PORT=8000
GATEWAY_PORT=3000
ENVIRONMENT=development  # development / production
BACKEND_URL=http://127.0.0.1:8000

# ── 数据库（生产环境使用 MySQL） ────────────────
# MySQL 连接串格式: mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=sqlite:///./bidgenerator.db
# DATABASE_URL=mysql+pymysql://biduser:password@127.0.0.1:3306/bid_generator

# ── Redis（可选，用于缓存和队列） ───────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── JWT 密钥（生产环境务必修改为随机字符串） ────
JWT_SECRET=change-this-to-a-random-secret-string

# ── DeepSeek API ────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 微信小程序 ──────────────────────────────────
WECHAT_APPID=wx_your_appid
WECHAT_SECRET=your_app_secret

# ── 微信支付（API v3） ──────────────────────────
WECHAT_MCHID=your_merchant_id
WECHAT_API_V3_KEY=your_api_v3_key
WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/notify/wechat
WECHAT_CERT_PATH=/path/to/apiclient_cert.pem
WECHAT_KEY_PATH=/path/to/apiclient_key.pem

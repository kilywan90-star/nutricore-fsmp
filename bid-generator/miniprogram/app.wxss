/* 全局样式 */
page { background: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.container { padding: 16px; min-height: 100vh; }

/* 首页 */
.hero { text-align: center; padding: 40px 20px; background: linear-gradient(135deg, #1677ff, #0958d9); border-radius: 12px; color: #fff; margin-bottom: 20px; }
.hero-title { font-size: 24px; font-weight: 700; margin-bottom: 8px; }
.hero-desc { font-size: 14px; opacity: 0.9; }
.section { margin-bottom: 20px; }
.section-title { font-size: 16px; font-weight: 600; margin-bottom: 12px; color: #333; }
.industry-scroll { white-space: nowrap; padding: 8px 0; }
.industry-item { display: inline-block; padding: 12px 20px; margin-right: 12px; background: #fff; border-radius: 8px; text-align: center; min-width: 80px; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.industry-item.active { background: #1677ff; color: #fff; }
.industry-icon { font-size: 28px; margin-bottom: 4px; }
.industry-name { font-size: 13px; }
.type-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.type-item { padding: 8px 16px; background: #fff; border-radius: 6px; font-size: 14px; border: 1px solid #e8e8e8; }
.type-item.active { border-color: #1677ff; color: #1677ff; background: #f0f5ff; }

/* 按钮 */
.btn-primary { background: #1677ff; color: #fff; border-radius: 8px; font-size: 16px; padding: 12px; border: none; width: 100%; margin-top: 12px; }
.btn-primary[disabled] { background: #ccc; }
.btn-secondary { background: #fff; color: #333; border: 1px solid #d9d9d9; border-radius: 8px; font-size: 14px; padding: 10px; }
.btn-buy { background: #1677ff; color: #fff; border-radius: 6px; font-size: 14px; padding: 8px 24px; border: none; }

/* 生成页 */
.steps { display: flex; align-items: center; justify-content: center; padding: 20px 0; font-size: 13px; }
.step { color: #999; }
.step.active { color: #1677ff; font-weight: 600; }
.step-arrow { margin: 0 8px; color: #ccc; }
.upload-area { border: 2px dashed #d9d9d9; border-radius: 12px; padding: 40px; text-align: center; background: #fff; margin-bottom: 16px; }
.upload-icon { font-size: 48px; margin-bottom: 8px; }
.upload-hint { color: #999; font-size: 12px; margin-top: 4px; }
.parsed-info { background: #fff; border-radius: 8px; padding: 12px; margin-bottom: 16px; }
.info-card { padding: 6px 0; font-size: 14px; }
.label { color: #666; }
.form-group { margin-bottom: 16px; }
.form-label { font-size: 14px; font-weight: 500; color: #333; margin-bottom: 6px; }
.form-input { background: #fff; border-radius: 8px; padding: 10px 12px; font-size: 14px; border: 1px solid #e8e8e8; }
.form-textarea { background: #fff; border-radius: 8px; padding: 10px 12px; font-size: 14px; border: 1px solid #e8e8e8; min-height: 120px; width: 100%; box-sizing: border-box; }
.form-actions { display: flex; gap: 12px; margin-top: 20px; }
.form-actions .btn-secondary { flex: 1; }
.form-actions .btn-primary { flex: 2; margin-top: 0; }
.generating-status { text-align: center; padding: 40px 0; }
.generating-spinner { width: 40px; height: 40px; border: 4px solid #e8e8e8; border-top: 4px solid #1677ff; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 16px; }
@keyframes spin { to { transform: rotate(360deg); } }
.generating-text { font-size: 18px; font-weight: 600; color: #333; }
.generating-progress { color: #1677ff; font-size: 14px; margin-top: 8px; }
.generating-hint { color: #999; font-size: 12px; margin-top: 8px; }
.generated-preview { background: #fff; border-radius: 8px; padding: 16px; min-height: 300px; margin-bottom: 16px; }
.preview-scroll { max-height: 60vh; }
.generate-actions { display: flex; gap: 12px; }
.generate-actions button { flex: 1; }

/* 编辑页 */
.toolbar { display: flex; gap: 8px; padding: 12px 0; }
.tool-btn { flex: 1; font-size: 13px; padding: 8px 4px; background: #fff; border-radius: 6px; border: 1px solid #e8e8e8; text-align: center; }
.validation-panel { background: #fff; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
.val-score { font-size: 20px; font-weight: 700; color: #1677ff; margin-bottom: 8px; }
.val-section { margin-bottom: 12px; }
.val-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
.val-item { font-size: 13px; color: #666; padding: 4px 0; border-bottom: 1px solid #f5f5f5; }
.val-suggestion { color: #1677ff; }
.val-summary { margin-top: 8px; padding: 8px; background: #f0f5ff; border-radius: 6px; font-size: 13px; }
.content-scroll { background: #fff; border-radius: 8px; padding: 16px; min-height: 50vh; }

/* 套餐页 */
.tabs { display: flex; background: #f0f0f0; border-radius: 8px; padding: 4px; margin-bottom: 20px; }
.tab { flex: 1; text-align: center; padding: 10px; border-radius: 6px; font-size: 14px; }
.tab.active { background: #fff; font-weight: 600; color: #1677ff; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
.plan-card, .pack-card { background: #fff; border-radius: 12px; padding: 20px; margin-bottom: 12px; box-shadow: 0 1px 6px rgba(0,0,0,.04); }
.plan-name { font-size: 16px; font-weight: 600; }
.plan-price { font-size: 32px; font-weight: 700; color: #1677ff; margin: 8px 0; }
.price-symbol { font-size: 18px; }
.price-period { font-size: 14px; color: #999; font-weight: 400; }
.plan-original { font-size: 13px; color: #999; text-decoration: line-through; }
.plan-features { margin: 12px 0; }
.feature { font-size: 13px; color: #666; padding: 3px 0; }
.plan-limit { font-size: 13px; color: #999; margin-bottom: 12px; }
.pack-name { font-size: 16px; font-weight: 600; }
.pack-meta { font-size: 13px; color: #666; margin: 4px 0; }
.pack-price { font-size: 28px; font-weight: 700; color: #1677ff; margin: 8px 0; }

/* 个人中心 */
.user-header { display: flex; align-items: center; background: #fff; border-radius: 12px; padding: 20px; margin-bottom: 16px; }
.avatar { width: 60px; height: 60px; border-radius: 50%; margin-right: 12px; }
.nickname { font-size: 18px; font-weight: 600; }
.member-badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 12px; margin-top: 4px; }
.member-badge.free { background: #f5f5f5; color: #999; }
.member-badge.monthly, .member-badge.yearly { background: #fff7e6; color: #fa8c16; }
.member-badge.enterprise { background: #f6ffed; color: #52c41a; }
.stats-row { display: flex; background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 16px; }
.stat-item { flex: 1; text-align: center; }
.stat-value { font-size: 22px; font-weight: 700; color: #1677ff; }
.stat-label { font-size: 12px; color: #999; margin-top: 4px; }
.menu-list { background: #fff; border-radius: 12px; overflow: hidden; margin-bottom: 16px; }
.menu-item { display: flex; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #f5f5f5; font-size: 14px; }
.menu-arrow { color: #ccc; }
.recent-orders { background: #fff; border-radius: 12px; padding: 16px; }
.order-item { display: flex; justify-content: space-between; padding: 8px 0; font-size: 13px; color: #666; border-bottom: 1px solid #f5f5f5; }

/* 模板中心 */
.industry-filter { white-space: nowrap; padding: 12px 0; }
.filter-item { display: inline-block; padding: 8px 16px; margin-right: 8px; background: #fff; border-radius: 20px; font-size: 13px; }
.filter-item.active { background: #1677ff; color: #fff; }
.template-card { background: #fff; border-radius: 10px; padding: 16px; margin-bottom: 10px; }
.template-name { font-size: 16px; font-weight: 600; }
.template-type { font-size: 12px; color: #1677ff; margin: 4px 0; }
.template-desc { font-size: 13px; color: #666; margin-bottom: 10px; }

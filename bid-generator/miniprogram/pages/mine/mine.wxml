<!-- 个人中心 -->
<view class="container">
  <view class="user-header">
    <image class="avatar" src="{{userInfo.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill"/>
    <view class="user-info">
      <view class="nickname">{{userInfo.nickname || '未登录'}}</view>
      <view class="member-badge {{userInfo.member_level}}">
        {{userInfo.member_level === 'free' ? '免费用户' : userInfo.member_level === 'yearly' ? '年度会员' : '会员'}}
      </view>
    </view>
    <button class="login-btn" wx:if="{{!userInfo}}" bindtap="login">微信登录</button>
  </view>

  <view class="stats-row">
    <view class="stat-item">
      <view class="stat-value">{{userInfo.daily_gen_count || 0}} / {{userInfo.daily_gen_limit || 1}}</view>
      <view class="stat-label">今日生成</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{userInfo.total_gen_remain || 0}}</view>
      <view class="stat-label">剩余次数</view>
    </view>
    <view class="stat-item">
      <view class="stat-value" bindtap="goToPlans">升级</view>
      <view class="stat-label">会员套餐</view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToPlans">
      <text>💎 会员套餐</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item">
      <text>📋 我的订单</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item">
      <text>📊 生成记录</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item">
      <text>❓ 帮助与反馈</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item">
      <text>📄 用户协议</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="recent-orders" wx:if="{{orders.length > 0}}">
    <view class="section-title">最近订单</view>
    <view class="order-item" wx:for="{{orders}}" wx:key="id">
      <view>{{item.product_name}}</view>
      <view>¥{{item.amount}} · {{item.status === 'paid' ? '已支付' : '待支付'}}</view>
    </view>
  </view>
</view>

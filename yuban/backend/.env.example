# 环境变量配置
# 复制此文件为 .env 并填入真实值

# 高德地图 API Key (必须)
# 获取: https://console.amap.com/dev/
AMAP_API_KEY=

# 和风天气 API Key (可选，不填则使用高德天气)
QWEATHER_API_KEY=

# 微信小程序
WX_APPID=
WX_SECRET=

# JWT密钥 (生产环境请更换)
JWT_SECRET_KEY=change-me-in-production

# 数据库 (MVP使用SQLite)
DATABASE_URL=sqlite+aiosqlite:///./yuban.db

# 调试模式
DEBUG=true

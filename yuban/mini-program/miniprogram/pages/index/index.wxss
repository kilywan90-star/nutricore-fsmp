/* 首页样式 */

.index-card {
  background: linear-gradient(135deg, #07C160 0%, #00A650 100%);
  color: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.index-header {
  margin-bottom: 16rpx;
}

.index-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.index-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
}

.index-score {
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  text-align: center;
}

.index-summary {
  font-size: 30rpx;
  margin: 16rpx 0;
  opacity: 0.95;
}

.weather-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}

.weather-item {
  text-align: center;
  flex: 1;
}

.weather-icon {
  font-size: 32rpx;
  display: block;
}

.weather-value {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin: 4rpx 0;
}

.weather-label {
  font-size: 20rpx;
  opacity: 0.8;
}

.index-actions {
  opacity: 0.85;
}

/* 快捷入口 */
.quick-actions {
  padding: 32rpx 24rpx;
}

.quick-item {
  text-align: center;
}

.quick-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 8rpx;
}

.quick-label {
  font-size: 24rpx;
  color: #666;
}

/* Feed */
.section-header {
  padding: 24rpx 24rpx 0 24rpx;
}

.feed-item {
  margin: 12rpx 24rpx;
  padding: 20rpx 24rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
}

.feed-content {
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fish-info {
  background: #fff8e1;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  display: inline-block;
}

.feed-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.feed-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #eee;
}

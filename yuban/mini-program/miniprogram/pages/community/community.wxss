/* 社区 */

.feed-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 3rpx solid transparent;
}

.tab-item.active {
  color: #07C160;
  border-bottom-color: #07C160;
  font-weight: bold;
}

.feed-scroll {
  height: calc(100vh - 140rpx);
  padding-bottom: 100rpx;
}

.post-card {
  margin: 12rpx 24rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.post-content {
  line-height: 1.7;
}

.fish-card {
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #ffe082;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.post-img {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  background: #eee;
}

.post-actions {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 发布按钮 */
.fab {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.4);
  z-index: 20;
}

.fab-text {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}

/* 发布弹窗 */
.publish-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; }
.modal-mask { background: rgba(0,0,0,0.5); width: 100%; height: 100%; }
.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 60vh;
}

.select-type {
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 28rpx;
}

.publish-input {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

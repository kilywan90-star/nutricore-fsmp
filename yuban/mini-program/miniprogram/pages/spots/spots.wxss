/* 钓点地图 */

.page-map {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
}

.search-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.search-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.search-filters {
  display: flex;
  gap: 12rpx;
}

.filter-chip {
  background: #f0f0f0;
  border-radius: 32rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #666;
}

.map-view {
  flex: 1;
  margin-top: 140rpx;
}

.spot-drawer {
  position: fixed;
  bottom: 90rpx;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 200rpx;
  transition: max-height 0.3s;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}

.spot-drawer.expanded {
  max-height: 60vh;
}

.drawer-handle {
  text-align: center;
  padding: 16rpx;
}

.handle-bar {
  width: 60rpx;
  height: 6rpx;
  background: #ddd;
  border-radius: 3rpx;
  margin: 0 auto 8rpx auto;
}

.spot-list {
  max-height: calc(60vh - 60rpx);
}

.spot-card {
  display: flex;
  gap: 16rpx;
  margin: 12rpx 24rpx;
  padding: 16rpx;
}

.spot-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eee;
}

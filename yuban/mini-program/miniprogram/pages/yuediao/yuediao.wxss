/* 约钓 */

.yuediao-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 30rpx;
  color: #666;
  border-bottom: 3rpx solid transparent;
}

.tab-item.active {
  color: #07C160;
  border-bottom-color: #07C160;
  font-weight: bold;
}

.tab-content {
  padding-bottom: 100rpx;
}

.list-scroll {
  height: calc(100vh - 140rpx);
}

.session-card, .companion-card {
  margin: 12rpx 24rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.avatar-lg {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.fab {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.4);
  z-index: 20;
}

.fab-text { color: #fff; font-size: 48rpx; font-weight: bold; }

.publish-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; }
.modal-mask { background: rgba(0,0,0,0.5); width: 100%; height: 100%; }
.modal-content {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 60vh;
}

.form-input {
  width: 100%;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.register-btn {
  text-align: center;
  padding: 24rpx;
  background: #fff;
  position: fixed;
  bottom: 100rpx;
  left: 24rpx;
  right: 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

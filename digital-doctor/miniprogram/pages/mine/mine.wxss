/* pages/mine/mine.wxss — Native "我的" page styles */

/* -- Login section -- */
.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--primary-light);
}
.login-hint {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
}
.login-btn {
  width: 320rpx;
  margin-top: 48rpx;
}

/* -- Profile card -- */
.profile-card {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, var(--primary), #4096ff);
  color: #fff;
}
.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.5);
}
.profile-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.nickname {
  font-size: 36rpx;
  font-weight: 600;
}
.profile-role {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

/* -- Health metrics -- */
.metrics-section {
  margin: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}
.metrics-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.metric-card {
  width: calc(50% - 8rpx);
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.metric-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.metric-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
  margin-top: 12rpx;
}

/* -- Actions -- */
.actions-section {
  margin: 24rpx;
  background: var(--bg-white);
  border-radius: 16rpx;
  overflow: hidden;
}
.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid var(--border);
}
.action-item:last-child {
  border-bottom: none;
}
.arrow {
  color: var(--text-secondary);
}

/* -- Logout -- */
.logout-section {
  margin: 48rpx 48rpx;
}
.logout-btn {
  width: 100%;
  background: var(--bg-white);
  color: var(--danger);
  font-size: 30rpx;
  border-radius: 12rpx;
}

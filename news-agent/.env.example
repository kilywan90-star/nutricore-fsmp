# ============================================
#   新闻智能体 News Agent - 配置文件
#   复制此文件为 .env 并填入实际密钥
#   cp .env.example .env
# ============================================

# ---- DeepSeek API (改写服务) ----
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 火山引擎 Ark API (豆包配图 Seedream) ----
# 获取地址: https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=your-ark-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-4-5-251128

# ---- NewsAPI.org (新闻采集) ----
# 免费注册: https://newsapi.org/register (日500次请求)
NEWSAPI_KEY=your-newsapi-key

# ---- 运行参数 (可选) ----
MAX_ARTICLES_PER_RUN=5
DEDUP_SIMILARITY_THRESHOLD=0.85
FINGERPRINT_TTL_DAYS=30
IMAGE_SIZE=2560x1440
LOG_LEVEL=INFO

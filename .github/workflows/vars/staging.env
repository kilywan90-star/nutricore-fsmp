# Staging Environment Variables
#
# These values are stored as GitHub Secrets in:
#   Settings > Environments > staging > Environment secrets
#
# ── Deployment SSH ─────────────────────────────────────────────
# STAGING_HOST          = staging server IP or hostname
# STAGING_USER          = SSH username (e.g., deploy)
# STAGING_SSH_KEY       = SSH private key for authentication
# STAGING_URL           = https://staging.example.com (base URL for smoke tests)
# STAGING_ADMIN_TOKEN   = Admin JWT token for smoke test API calls
#
# ── Application Secrets ────────────────────────────────────────
# DATABASE_URL          = postgresql+asyncpg://user:pass@host:5432/db
# REDIS_URL             = redis://host:6379/0
# SECRET_KEY            = random-64-char-secret-key
# PHI_ENCRYPTION_KEY    = 32-byte-hex-encryption-key
# LLM_API_KEY           = OpenAI/LLM API key
# LLM_BASE_URL          = https://api.openai.com/v1
# LLM_MODEL             = gpt-4o
# WECHAT_APPID          = WeChat mini-program AppID
# WECHAT_SECRET         = WeChat mini-program AppSecret
# DB_PASSWORD           = PostgreSQL password
#
# ── Backup / S3 ─────────────────────────────────────────────────
# BACKUP_S3_BUCKET      = s3 bucket name for offsite backups
# BACKUP_S3_ENDPOINT    = S3-compatible endpoint URL
# BACKUP_RETENTION_DAYS = 30
#
# ── Notifications ───────────────────────────────────────────────
# SLACK_WEBHOOK_URL     = Slack incoming webhook for deploy notifications
# CODECOV_TOKEN         = Codecov upload token (optional)

# Production Environment Variables
#
# These values are stored as GitHub Secrets in:
#   Settings > Environments > production > Environment secrets
#
# ── Deployment SSH ─────────────────────────────────────────────
# PROD_HOST             = production server IP or hostname
# PROD_USER             = SSH username (e.g., deploy)
# PROD_SSH_KEY          = SSH private key for authentication
# PROD_URL              = https://app.example.com (base URL for smoke tests)
# PROD_ADMIN_TOKEN      = Admin JWT token for smoke test API calls
#
# ── Application Secrets ────────────────────────────────────────
# DATABASE_URL          = postgresql+asyncpg://user:pass@host:5432/db
# REDIS_URL             = redis://host:6379/0
# SECRET_KEY            = random-64-char-secret-key (PRODUCTION STRONG)
# PHI_ENCRYPTION_KEY    = 32-byte-hex-encryption-key (PRODUCTION UNIQUE)
# LLM_API_KEY           = OpenAI/LLM API key
# LLM_BASE_URL          = https://api.openai.com/v1
# LLM_MODEL             = gpt-4o
# WECHAT_APPID          = WeChat mini-program AppID
# WECHAT_SECRET         = WeChat mini-program AppSecret
# DB_PASSWORD           = PostgreSQL password
#
# ── Backup / S3 ─────────────────────────────────────────────────
# BACKUP_S3_BUCKET      = s3 bucket name for offsite backups
# BACKUP_S3_ENDPOINT    = S3-compatible endpoint URL
# BACKUP_RETENTION_DAYS = 90
#
# ── Notifications ───────────────────────────────────────────────
# SLACK_WEBHOOK_URL     = Slack incoming webhook for deploy notifications
